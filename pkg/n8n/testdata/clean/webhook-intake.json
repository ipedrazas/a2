      "typeVersion": 1.1,
      "position": [400, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"status\": \"ok\"} }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [600, -150]
    },
    {
      "parameters": {
        "operation": "postMessage",
        "channel": "#lead-intake-alerts",
        "text": "=Lead save failed: {{ $json.error.message }}",
        "otherOptions": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
